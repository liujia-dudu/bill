{
  "name": "invoice-desk",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node tools/patch-harness-windows.mjs",
    "predev": "node tools/patch-harness-windows.mjs && node tools/cleanup.mjs",
    "dev": "node src/server/index.mjs --dev",
    "build": "vite build",
    "prestart": "node tools/patch-harness-windows.mjs && node tools/cleanup.mjs",
    "start": "node src/server/index.mjs",
    "pretest": "node tools/cleanup.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:harness": "node tests/harness-live.mjs",
    "test:chat": "node tests/chat-live.mjs",
    "browser:install": "playwright install chromium",
    "check:adapters": "node tools/check-adapters.mjs",
    "check:publish": "node tools/check-publish.mjs --staged",
    "cleanup": "node tools/cleanup.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "express": "5.3.0",
    "lexmount": "0.6.1",
    "lucide-react": "1.57.0",
    "multer": "2.4.0",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "vite": "8.3.4"
  },
  "overrides": {
    "fflate": "0.8.3"
  }
}
